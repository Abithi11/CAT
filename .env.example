# --- Database & JWT (required) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cat
JWT_SECRET=change-me-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LM Studio (OpenAI-compatible local LLM) ---
# Model is auto-detected from /v1/models when LLM_MODEL is left empty
# (embedding/reranker models are skipped automatically).
#
# IMPORTANT for Docker: mDNS ".local" hostnames do NOT resolve inside
# containers. Use one of:
#   LM Studio on another machine  -> http://<its-ip>:1234/v1
#   LM Studio on the Docker host  -> http://host.docker.internal:1234/v1
# Running the app outside Docker, a ".local" name is fine.
# The API logs LM Studio reachability at startup — check it before demoing.
LLM_BASE_URL=http://trinity.local:1234/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# --- SMTP alert email (optional — leave SMTP_HOST empty to disable email;
#     in-app alerts on the dashboard work regardless) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Alert scheduler (APScheduler) ---
SCHEDULER_ENABLED=true
ALERT_SCAN_INTERVAL_MINUTES=15

# --- Demo tenant created on docker-compose bring-up ---
DEMO_TENANT_SLUG=demo
DEMO_EMAIL=demo@cat.com
DEMO_PASSWORD=demo1234
